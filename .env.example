# Prometheus + Grafana для мониторинга vLLM, SGLang и LiteLLM

# vLLM сервер 1 (адрес и порт метрик)
VLLM1_METRICS_HOST=192.168.45.10
VLLM1_METRICS_PORT=30000

# vLLM сервер 2 (адрес и порт метрик)
VLLM2_METRICS_HOST=192.168.45.10
VLLM2_METRICS_PORT=30070

# SGLang сервер (адрес и порт метрик)
SGLANG_METRICS_HOST=192.168.45.10
SGLANG_METRICS_PORT=30070

# llama.cpp сервер (адрес и порт метрик)
LLAMACPP_METRICS_HOST=192.168.45.10
LLAMACPP_METRICS_PORT=30000

# LiteLLM proxy (адрес и порт метрик)
LITELLM_METRICS_HOST=192.168.45.30
LITELLM_METRICS_PORT=31003

# Скорость опроса метрик (в секундах)
SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Порты
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Retention - сколько хранить метрики
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
